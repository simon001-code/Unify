# ================================================================
# Unify - Configuration (.env.example)
# Copy this file to .env and fill in your values
# ================================================================

# GEMINI_API_KEY: Required when PROVIDER=api
# Get your free key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: Choose 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
# Values: 'api' | 'local'
PROVIDER="api"

# GEMMA_API_MODEL: Exact Gemma 4 model ID on Google AI Studio
# Options: 'gemma-4-26b-a4b-it' (fast MoE) or 'gemma-4-31b-it' (dense)
GEMMA_API_MODEL="gemma-4-26b-a4b-it"

# OLLAMA CONFIGURATION (used when PROVIDER=local)
# Make sure Ollama is running: ollama run gemma4:e2b
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# Server Port
PORT=3000
